# Environment
.env
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data (never commit raw data)
data/
*.csv
*.json
*.parquet
*.feather
*.pkl
*.pickle

# Outputs — exclude large/generated files
outputs/tableau/*.hyper
outputs/tableau/*.tde

# Tableau-ready export CSVs are committed (small, curated portfolio assets)
!outputs/tableau/*.csv

# Tableau
*.twbx
*.twb

# OS
.DS_Store
Thumbs.db
desktop.ini

